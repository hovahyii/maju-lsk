# 1. Performance: Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 2. Performance: Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>

# 3. WebP Support
AddType image/webp .webp

# 4. Security: Disable Directory Listing
Options -Indexes

# 5. Security: Explicitly Allow common web assets
# This helps bypass some restrictive server configuration defaults
<FilesMatch "\.(html|php|js|css|webp|png|jpg|jpeg|gif|ico|svg|xml|json|webmanifest)$">
    Require all granted
</FilesMatch>

# 6. Security: Deny access to sensitive files (OVERRIDE)
<FilesMatch "(\.env|\.ini|\.log|\.sql|db\.php|generate_sql\.js)$">
    Require all denied
</FilesMatch>

# 7. Security: HTTP Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # COOP: Changed to allow more flexibility for 3rd party embeds
  Header set Cross-Origin-Opener-Policy "unsafe-none"

  # CORP: Allows resources to be loaded cross-origin
  Header set Cross-Origin-Resource-Policy "cross-origin"

  # Updated CSP
  Header set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \
    font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; \
    img-src 'self' data: https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.gstatic.com https://flagcdn.com; \
    connect-src 'self' https://maps.googleapis.com https://*.googleapis.com; \
    frame-src 'self' https://www.google.com https://maps.google.com; \
    object-src 'none'; base-uri 'self'"
</IfModule>